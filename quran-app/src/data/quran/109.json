{"nomor":109,"nama":"الكافرون","namaLatin":"Al-Kafirun","arti":"Orang-orang Kafir","tempatTurun":"Mekah","jumlahAyat":6,"ayat":[{"nomorAyat":1,"teksArab":"قُلۡ يَـٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","teksLatin":"Qul ya ayyuha alkafiroona","teksIndonesia":"Katakanlah (Muhammad), \"Wahai orang-orang kafir"},{"nomorAyat":2,"teksArab":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","teksLatin":"La aAAbudu ma taAAbudoona","teksIndonesia":"aku tidak akan menyembah apa yang kamu sembah"},{"nomorAyat":3,"teksArab":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","teksLatin":"Wala antum AAabidoona ma aAAbudu","teksIndonesia":"dan kamu bukan penyembah apa yang aku sembah"},{"nomorAyat":4,"teksArab":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","teksLatin":"Wala ana AAabidun ma AAabadtum","teksIndonesia":"dan aku tidak pernah menjadi penyembah apa yang kamu sembah"},{"nomorAyat":5,"teksArab":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","teksLatin":"Wala antum AAabidoona ma aAAbudu","teksIndonesia":"dan kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah"},{"nomorAyat":6,"teksArab":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","teksLatin":"Lakum deenukum waliya deeni","teksIndonesia":"Untukmu agamamu, dan untukku agamaku"}]}