{"nomor":94,"nama":"الشرح","namaLatin":"Ash-Sharh","arti":"Melapangkan","tempatTurun":"Mekah","jumlahAyat":8,"ayat":[{"nomorAyat":1,"teksArab":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","teksLatin":"Alam nashrah laka sadraka","teksIndonesia":"Bukankah kami telah melapangkan dadamu (Muhammad)"},{"nomorAyat":2,"teksArab":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","teksLatin":"WawadaAAna AAanka wizraka","teksIndonesia":"dan kami pun telah menurunkan beban darimu"},{"nomorAyat":3,"teksArab":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","teksLatin":"Allathee anqada thahraka","teksIndonesia":"yang memberatkan punggungmu"},{"nomorAyat":4,"teksArab":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","teksLatin":"WarafaAAna laka thikraka","teksIndonesia":"dan kami tinggikan sebutan (nama)mu914) bagimu"},{"nomorAyat":5,"teksArab":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","teksLatin":"Fainna maAAa alAAusri yusran","teksIndonesia":"Maka sesungguhnya bersama kesulitan ada kemudahan"},{"nomorAyat":6,"teksArab":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","teksLatin":"Inna maAAa alAAusri yusran","teksIndonesia":"sesungguhnya bersama kesulitan ada kemudahan"},{"nomorAyat":7,"teksArab":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","teksLatin":"Faitha faraghta fainsab","teksIndonesia":"Maka apabila engkau telah selesai (dari suatu urusan), tetaplah bekerja keras (untuk urusan yang lain)"},{"nomorAyat":8,"teksArab":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","teksLatin":"Waila rabbika fairghab","teksIndonesia":"dan hanya kepada Tuhanmulah engkau berharap"}]}