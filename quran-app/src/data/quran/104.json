{"nomor":104,"nama":"الهمزة","namaLatin":"Al-Humazah","arti":"Pengumpat","tempatTurun":"Mekah","jumlahAyat":9,"ayat":[{"nomorAyat":1,"teksArab":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","teksLatin":"Waylun likulli humazatin lumazatin","teksIndonesia":"Celakalah bagi setiap pengumpat dan pencela"},{"nomorAyat":2,"teksArab":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","teksLatin":"Allathee jamaAAa malan waAAaddadahu","teksIndonesia":"yang mengumpulkan harta dan menghitung-hitungnya"},{"nomorAyat":3,"teksArab":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","teksLatin":"Yahsabu anna malahu akhladahu","teksIndonesia":"dia (manusia) mengira bahwa hartanya itu dapat mengekalkannya"},{"nomorAyat":4,"teksArab":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","teksLatin":"Kalla layunbathanna fee alhutamati","teksIndonesia":"Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Ḥuṭamah"},{"nomorAyat":5,"teksArab":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","teksLatin":"Wama adraka ma alhutamatu","teksIndonesia":"Dan tahukah kamu apakah (neraka) Ḥuṭamah itu"},{"nomorAyat":6,"teksArab":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","teksLatin":"Naru Allahi almooqadatu","teksIndonesia":"(Yaitu) api (azab) Allah yang dinyalakan"},{"nomorAyat":7,"teksArab":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","teksLatin":"Allatee tattaliAAu AAala alafidati","teksIndonesia":"yang (membakar) sampai ke hati"},{"nomorAyat":8,"teksArab":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","teksLatin":"lnnaha AAalayhim musadatun","teksIndonesia":"Sungguh, api itu ditutup rapat atas (diri) mereka"},{"nomorAyat":9,"teksArab":"فِي عَمَدٖ مُّمَدَّدَةِۭ","teksLatin":"Fee AAamadin mumaddadatin","teksIndonesia":"(sedang mereka itu) diikat pada tiang-tiang yang panjang"}]}