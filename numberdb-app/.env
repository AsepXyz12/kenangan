# ==== Database ====
# PostgreSQL connection string. Works with Vercel Postgres, Neon, or Supabase.
DATABASE_URL="postgresql://user:password@host:5432/asepxyz_numberdb?sslmode=require"

# ==== Auth / JWT ====
# Generate a strong random secret: `openssl rand -base64 48`
JWT_SECRET="U0ex27l9PR3XMr7p8NXG0P3tnxtS1wBszfCl/zgpje1KmqT/vlAKReZuJOCK4w17"
# Session lifetime in seconds. Default 8 hours.
SESSION_MAX_AGE=28800
# "Remember me" lifetime in seconds. Default 30 days.
SESSION_REMEMBER_MAX_AGE=2592000

# ==== Owner seed account (used by `npm run db:seed`) ====
OWNER_USERNAME="AsepXyz"
OWNER_PASSWORD="AsepXRazaXSeven"

# ==== Rate limiting ====
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# ==== App ====
NEXT_PUBLIC_APP_NAME="AsepXyz Number Database Manager"
