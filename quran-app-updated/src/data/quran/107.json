{"nomor":107,"nama":"الماعون","namaLatin":"Al-Ma'un","arti":"Barang yang Berguna","tempatTurun":"Mekah","jumlahAyat":7,"ayat":[{"nomorAyat":1,"teksArab":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","teksLatin":"Araayta allathee yukaththibu bialddeeni","teksIndonesia":"Tahukah kamu (orang) yang mendustakan agama"},{"nomorAyat":2,"teksArab":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","teksLatin":"Fathalika allathee yaduAAAAu alyateema","teksIndonesia":"Maka itulah orang yang menghardik anak yatim"},{"nomorAyat":3,"teksArab":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","teksLatin":"Wala yahuddu AAala taAAami almiskeeni","teksIndonesia":"dan tidak mengajak memberi makan orang miskin"},{"nomorAyat":4,"teksArab":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","teksLatin":"Fawaylun lilmusalleena","teksIndonesia":"Maka celakalah orang yang salat"},{"nomorAyat":5,"teksArab":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","teksLatin":"Allatheena hum AAan salatihim sahoona","teksIndonesia":"(yaitu) orang-orang yang lalai terhadap salatnya"},{"nomorAyat":6,"teksArab":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","teksLatin":"Allatheena hum yuraoona","teksIndonesia":"yang berbuat riya"},{"nomorAyat":7,"teksArab":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","teksLatin":"WayamnaAAoona almaAAoona","teksIndonesia":"dan enggan (memberikan) bantuan"}]}