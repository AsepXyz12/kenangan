{"nomor":113,"nama":"الفلق","namaLatin":"Al-Falaq","arti":"Waktu Shubuh","tempatTurun":"Mekah","jumlahAyat":5,"ayat":[{"nomorAyat":1,"teksArab":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","teksLatin":"Qul aAAoothu birabbi alfalaqi","teksIndonesia":"Katakanlah, \"Aku berlindung kepada Tuhan yang menguasai subuh (fajar)"},{"nomorAyat":2,"teksArab":"مِن شَرِّ مَا خَلَقَ","teksLatin":"Min sharri ma khalaqa","teksIndonesia":"dari kejahatan (makhluk yang) Dia ciptakan"},{"nomorAyat":3,"teksArab":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","teksLatin":"Wamin sharri ghasiqin itha waqaba","teksIndonesia":"dan dari kejahatan malam apabila telah gelap gulita"},{"nomorAyat":4,"teksArab":"وَمِن شَرِّ ٱلنَّفَّـٰثَٰتِ فِي ٱلۡعُقَدِ","teksLatin":"Wamin sharri alnnaffathati fee alAAuqadi","teksIndonesia":"dan dari kejahatan (perempuan-perempuan) penyihir yang meniup pada buhul-buhul (talinya)"},{"nomorAyat":5,"teksArab":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","teksLatin":"Wamin sharri hasidin itha hasada","teksIndonesia":"dan dari kejahatan orang yang dengki apabila dia dengki"}]}