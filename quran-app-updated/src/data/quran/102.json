{"nomor":102,"nama":"التكاثر","namaLatin":"At-Takathur","arti":"Bermegah-megahan","tempatTurun":"Mekah","jumlahAyat":8,"ayat":[{"nomorAyat":1,"teksArab":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","teksLatin":"Alhakumu alttakathuru","teksIndonesia":"Bermegah-megahan telah melalaikan kamu"},{"nomorAyat":2,"teksArab":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","teksLatin":"Hatta zurtumu almaqabira","teksIndonesia":"sampai kamu masuk ke dalam kubur"},{"nomorAyat":3,"teksArab":"كَلَّا سَوۡفَ تَعۡلَمُونَ","teksLatin":"Kalla sawfa taAAlamoona","teksIndonesia":"Sekali-kali tidak! Kelak kamu akan mengetahui (akibat perbuatanmu itu)"},{"nomorAyat":4,"teksArab":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","teksLatin":"Thumma kalla sawfa taAAlamoona","teksIndonesia":"kemudian sekali-kali tidak! Kelak kamu akan mengetahui"},{"nomorAyat":5,"teksArab":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","teksLatin":"Kalla law taAAlamoona AAilma alyaqeeni","teksIndonesia":"Sekali-kali tidak! Sekiranya kamu mengetahui dengan pasti"},{"nomorAyat":6,"teksArab":"لَتَرَوُنَّ ٱلۡجَحِيمَ","teksLatin":"Latarawunna aljaheema","teksIndonesia":"niscaya kamu benar-benar akan melihat neraka Jahim"},{"nomorAyat":7,"teksArab":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","teksLatin":"Thumma latarawunnaha AAayna alyaqeeni","teksIndonesia":"kemudian kamu benar-benar akan melihatnya dengan mata kepala sendiri"},{"nomorAyat":8,"teksArab":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","teksLatin":"Thumma latusalunna yawmaithin AAani alnnaAAeemi","teksIndonesia":"kemudian kamu benar-benar akan ditanya pada hari itu tentang kenikmatan (yang megah di dunia itu)"}]}