{"nomor":101,"nama":"القارعة","namaLatin":"Al-Qari'ah","arti":"Hari Kiamat","tempatTurun":"Mekah","jumlahAyat":11,"ayat":[{"nomorAyat":1,"teksArab":"ٱلۡقَارِعَةُ","teksLatin":"AlqariAAatu","teksIndonesia":"Hari Kiamat"},{"nomorAyat":2,"teksArab":"مَا ٱلۡقَارِعَةُ","teksLatin":"Ma alqariAAatu","teksIndonesia":"Apakah hari Kiamat itu"},{"nomorAyat":3,"teksArab":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","teksLatin":"Wama adraka ma alqariAAatu","teksIndonesia":"Dan tahukah kamu apakah hari Kiamat itu"},{"nomorAyat":4,"teksArab":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","teksLatin":"Yawma yakoonu alnnasu kaalfarashi almabthoothi","teksIndonesia":"Pada hari itu manusia seperti laron yang beterbangan"},{"nomorAyat":5,"teksArab":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","teksLatin":"Watakoonu aljibalu kaalAAihni almanfooshi","teksIndonesia":"dan gunung-gunung seperti bulu yang dihambur-hamburkan"},{"nomorAyat":6,"teksArab":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","teksLatin":"Faamma man thaqulat mawazeenuhu","teksIndonesia":"Maka adapun orang yang berat timbangan (kebaikan)nya"},{"nomorAyat":7,"teksArab":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","teksLatin":"Fahuwa fee AAeeshatin radiyatin","teksIndonesia":"maka dia berada dalam kehidupan yang memuaskan (senang)"},{"nomorAyat":8,"teksArab":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","teksLatin":"Waamma man khaffat mawazeenuhu","teksIndonesia":"Dan adapun orang yang ringan timbangan (kebaikan)nya"},{"nomorAyat":9,"teksArab":"فَأُمُّهُۥ هَاوِيَةٞ","teksLatin":"Faommuhu hawiyatun","teksIndonesia":"maka tempat kembalinya adalah neraka Hāwiyah"},{"nomorAyat":10,"teksArab":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","teksLatin":"Wama adraka ma hiyah","teksIndonesia":"Dan tahukah kamu apakah neraka Hāwiyah itu"},{"nomorAyat":11,"teksArab":"نَارٌ حَامِيَةُۢ","teksLatin":"Narun hamiyatun","teksIndonesia":"(Yaitu) api yang sangat panas"}]}